{
  "name": "ultra-metaverse",
  "version": "1.0.0",
  "description": "AI-powered development platform that integrates existing AI engines with a self-evolving intelligence core",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "example": "ts-node examples/usage-example.ts"
  },
  "keywords": [
    "ai",
    "metaverse",
    "development-platform",
    "blockchain",
    "adaptive-ui",
    "tool-generation",
    "gata-os",
    "decentralized"
  ],
  "author": "Ultra Cube Tech",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "ws": "^8.13.0",
    "uuid": "^9.0.0",
    "axios": "^1.5.0",
    "eventemitter3": "^4.0.7",
    "joi": "^17.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/ws": "^8.5.5",
    "@types/uuid": "^9.0.2",
    "@types/jest": "^29.5.4",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "prettier": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}