# Ultra-MetaVerse AI Platform Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=8080
HOST=localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# AI Engine Configuration
DEFAULT_AI_ENGINE=openai-gpt
MAX_CONCURRENT_REQUESTS=10
AI_RESPONSE_TIMEOUT=30000
LEARNING_ENABLED=true

# AI Engine API Keys (configure the ones you want to use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Adaptive UI Configuration
ADAPTATION_ENABLED=true
ADAPTATION_INTERVAL=60000
MAX_ADAPTATIONS=100

# Blockchain Configuration
BLOCKCHAIN_NETWORK=ethereum-sepolia
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
GAS_LIMIT=500000
CONFIRMATIONS=3

# Security Configuration
ENCRYPTION_KEY=your_secure_encryption_key_here_change_in_production
TOKEN_EXPIRY=86400000
MAX_LOGIN_ATTEMPTS=5

# Gata-OS Integration (if available)
GATA_OS_ENDPOINT=http://localhost:9000/gata-os
GATA_OS_VERSION=1.0.0

# Development Configuration
NODE_ENV=development
DEBUG=ultra-metaverse:*

# Optional: Database Configuration (for future persistence features)
# DATABASE_URL=mongodb://localhost:27017/ultra-metaverse
# REDIS_URL=redis://localhost:6379

# Optional: Cloud Storage (for storing generated tools and models)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=ultra-metaverse-storage